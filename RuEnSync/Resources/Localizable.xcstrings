{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "%@ — %@" : {
      "comment" : "Device status row: name — lowercased reason. Both pieces are already localized; this is a layout-only format.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — %2$@"
          }
        }
      }
    },
    "%@ → %@" : {
      "comment" : "Activity log: per-app layout override (bundleId → layoutName).",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@"
          }
        }
      }
    },
    "%@ connected" : {
      "comment" : "Activity log: device connected.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ подключено"
          }
        }
      }
    },
